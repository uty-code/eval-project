# ==========================================================================
# EES Production 환경 변수 설정 템플릿
# 실제 우분투 서버의 ~/ees-app/.env 파일로 복사하여 사용하십시오.
# ==========================================================================

# 1. Database Connection - SKU 공용 DB 연결 문자열
DB_URL=jdbc:sqlserver://211.232.94.161:1533;databaseName=SKUEDU;encrypt=true;trustServerCertificate=true;

# 2. Database Credentials
DB_USERNAME=SKUEDU01
DB_PASSWORD=your_db_password

# 3. Docker Deployment Tag (젠킨스 빌드 번호 기반 불변 배포용)
TAG=latest
BACKUP_TAG=latest

# 4. SSL 인증서 발급용 이메일 (Let's Encrypt / Certbot)
CERTBOT_EMAIL=your-email@example.com
