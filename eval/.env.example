# ==========================================================================
# EES Production 환경 변수 설정 템플릿
# 실제 우분투 서버의 ~/ees-app/.env 파일로 복사하여 사용하십시오.
# ==========================================================================

# 1. Database Server Connection Information
DB_HOST=your-database-server-ip
DB_PORT=1433
DB_NAME=ees_db

# 2. Database Server Credentials
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
