def healthCheckFailed = false

pipeline {
    agent any

    options {
        // 다중 배포 간 충돌 및 태그 꼬임 방지
        disableConcurrentBuilds()
        // 빌드 지연으로 인한 젠킨스 익스큐터 대기 시간 제한 (20분)
        timeout(time: 20, unit: 'MINUTES')
    }

    environment {
        REGISTRY_USER = 'siujeong'
        IMAGE_NAME = 'ees-eval-app'
        TAG = "${env.BUILD_NUMBER}"
        REGISTRY_CRED_ID = 'ees-registry-creds' 
        // 빌드 속도 개선을 위한 Docker BuildKit 활성화
        DOCKER_BUILDKIT = '1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Build & Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: env.REGISTRY_CRED_ID, usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                    // 젠킨스 로그 및 프로세스 메모리 상의 패스워드 유출 방지
                    sh '''
                        set +x
                        set -e
                        echo "$REG_PASS" | docker login -u "$REG_USER" --password-stdin
                    '''
                    
                    // 불변 빌드 번호(${TAG}) 이미지를 빌드 및 푸시 (latest는 보조 참조용으로만 운용)
                    // --pull 옵션을 병렬 주입하여 항상 최신 베이스 이미지의 보안 패치를 반영합니다.
                    dir('eval') {
                        sh '''
                            set -e
                            docker build --pull -t "$REGISTRY_USER"/"$IMAGE_NAME":"$TAG" .
                            docker push "$REGISTRY_USER"/"$IMAGE_NAME":"$TAG"
                            
                            docker tag "$REGISTRY_USER"/"$IMAGE_NAME":"$TAG" "$REGISTRY_USER"/"$IMAGE_NAME":latest
                            docker push "$REGISTRY_USER"/"$IMAGE_NAME":latest
                        '''
                    }
                }
            }
        }

        stage('Remote Deploy') {
            steps {
                sshPublisher(publishers: [
                    sshPublisherDesc(configName: 'ees-ubuntu-server', 
                        verbose: true,
                        transfers: [
                          sshTransfer(
                            sourceFiles: 'eval/docker-compose.prod.yml, eval/.env.example, eval/deploy_verify.sh, eval/rollback.sh, eval/nginx/nginx.conf, eval/nginx/nginx-ssl.conf, eval/init-ssl.sh',
                            removePrefix: 'eval',
                            remoteDirectory: 'ees-app',
                            execCommand: '''
                              set +x
                              set -e
                            ''' + "\nTAG='${TAG}'\n" + '''
                              cd ~/ees-app

                              # Nginx 및 Certbot용 호스트 볼륨 디렉토리 생성
                              mkdir -p letsencrypt certbot nginx
                              
                              # 처음 배포 시 .env 파일 복사
                              if [ ! -f .env ]; then
                                cp .env.example .env
                                echo "⚠️ [WARNING] .env 파일이 생성되었습니다. 연결을 채워주십시오."
                              fi
                              
                              # 이전 가동 중이던 이미지 버전을 .env에서 백업 태그로 보관
                              OLD_TAG=$(grep -E "^TAG=" .env | cut -d'=' -f2 || echo "latest")
                              
                              grep -q "^BACKUP_TAG=" .env \
                                && sed -i "s/^BACKUP_TAG=.*/BACKUP_TAG=${OLD_TAG}/" .env \
                                || echo "BACKUP_TAG=${OLD_TAG}" >> .env
                              
                              # .env 파일에 새로운 배포 태그 적용
                              grep -q "^TAG=" .env \
                                && sed -i "s/^TAG=.*/TAG=${TAG}/" .env \
                                || echo "TAG=${TAG}" >> .env
                              
                              # 배포 중 모니터링 데몬 오탐지 방지용 플래그 생성
                              touch .deploying
                              
                              # 새 이미지 정밀 pull (원격 서버의 도커 데몬 자동 캐시 인증 가동)
                              docker compose --compatibility -f docker-compose.prod.yml pull
                              
                              # 불변 이미지를 기반으로 무중단 배포 및 누적 고아 컨테이너 Prune 처리
                              docker compose --compatibility -f docker-compose.prod.yml up -d --remove-orphans
                              
                              # Nginx 볼륨 마운트 설정(nginx.conf) 갱신을 위해 컨테이너 재시작
                              docker restart ees-nginx || true
                              
                              chmod +x ./deploy_verify.sh ./rollback.sh ./init-ssl.sh
                            '''
                          )
                        ]
                    )
                ])
            }
        }

        stage('Health Check') {
            steps {
                script {
                    try {
                        sshPublisher(publishers: [
                            sshPublisherDesc(configName: 'ees-ubuntu-server', 
                                verbose: true,
                                transfers: [
                                  sshTransfer(
                                    execCommand: '''
                                      cd ~/ees-app
                                      timeout 60 ./deploy_verify.sh
                                    '''
                                  )
                                ]
                            )
                        ])
                    } catch (Exception e) {
                        echo "⚠️ Health check failed! Marking build for rollback."
                        healthCheckFailed = true
                    }
                }
            }
        }

        stage('Rollback') {
            when {
                expression { healthCheckFailed }
            }
            steps {
                script {
                    echo "🚨 Health check failed. Executing Rollback on remote server..."
                    sshPublisher(publishers: [
                        sshPublisherDesc(configName: 'ees-ubuntu-server', 
                            verbose: true,
                            transfers: [
                              sshTransfer(
                                execCommand: '''
                                  cd ~/ees-app
                                  docker compose --compatibility -f docker-compose.prod.yml down || true
                                  ./rollback.sh
                                '''
                              )
                            ]
                        )
                    ])
                    error "Deploy health check failed. Rollback executed successfully."
                }
            }
        }
    }

    post {
        always {
            script {
                def status = currentBuild.currentResult ?: 'SUCCESS'

                def title = status == 'SUCCESS'
                    ? "✅ EES 빌드 #${env.BUILD_NUMBER} 배포 성공"
                    : "❌ EES 빌드 #${env.BUILD_NUMBER} 배포 실패"

                def desc = status == 'SUCCESS'
                    ? "KT Cloud 서버 배포가 정상 완료되었습니다."
                    : "배포 실패로 인해 롤백이 수행되었습니다."

                def color = status == 'SUCCESS'
                    ? 3066993
                    : 15158332

                withCredentials([string(credentialsId: 'discord-webhook-url', variable: 'DISCORD_WEBHOOK')]) {
                    def payload = """
                    {
                      "embeds": [{
                        "title": "${title}",
                        "description": "${desc}",
                        "color": ${color},
                        "fields": [
                          {
                            "name": "브랜치",
                            "value": "main",
                            "inline": true
                          },
                          {
                            "name": "빌드 번호",
                            "value": "${env.BUILD_NUMBER}",
                            "inline": true
                          }
                        ]
                      }]
                    }
                    """

                    sh """
                    set +x
                    curl -s -X POST \
                    -H 'Content-Type: application/json' \
                    -d '${payload}' \
                    "\$DISCORD_WEBHOOK" || true
                    """
                }
            }

            // 사용하지 않는 빌드 이미지 정리 및 로그아웃
            sh 'docker logout || true'
            sh "docker rmi ${REGISTRY_USER}/${IMAGE_NAME}:${TAG} || true"
            sh "docker rmi ${REGISTRY_USER}/${IMAGE_NAME}:latest || true"
            sh 'docker image prune -f --filter "until=24h" || true'
            cleanWs()
        }
    }
}