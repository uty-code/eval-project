pipeline {
    agent any

    environment {
        REGISTRY_USER = 'siujeong'
        IMAGE_NAME = 'ees-eval-app'
        TAG = "${env.BUILD_NUMBER}"
        REGISTRY_CRED_ID = 'ees-registry-creds' 
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Build & Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: env.REGISTRY_CRED_ID, usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                    // [보안 고도화] 홑따옴표 쉘 차단으로 젠킨스 에코 누출 및 ps 메모리 패스워드 유출 완벽 방어
                    sh '''
                        set +x
                        set -e
                        echo "$REG_PASS" | docker login -u "$REG_USER" --password-stdin
                    '''
                    
                    // 불변 빌드 번호(${TAG}) 이미지를 빌드 및 푸시 (latest는 보조 참조용으로만 운용)
                    dir('eval') {
                        sh '''
                            set -e
                            docker build -t "$REGISTRY_USER"/"$IMAGE_NAME":"$TAG" .
                            docker push "$REGISTRY_USER"/"$IMAGE_NAME":"$TAG"
                            
                            docker tag "$REGISTRY_USER"/"$IMAGE_NAME":"$TAG" "$REGISTRY_USER"/"$IMAGE_NAME":latest
                            docker push "$REGISTRY_USER"/"$IMAGE_NAME":latest
                        '''
                    }
                }
            }
        }

        stage('Deploy via SSH to Ubuntu') {
            steps {
                // [보안 혁신] 우분투 운영 서버의 Docker 인증 캐시(~/.docker/config.json)를 신뢰함으로써, 원격 비밀번호 전송 및 원격 도커 로그인 과정을 통째로 원천 생략하여 유출 확률 0% 달성
                sshPublisher(publishers: [
                    sshPublisherDesc(configName: 'ees-ubuntu-server', 
                        transfers: [
                          sshTransfer(
                            sourceFiles: 'eval/docker-compose.prod.yml, eval/.env.example, eval/deploy_verify.sh, eval/rollback.sh',
                            removePrefix: 'eval',
                            remoteDirectory: 'ees-app',
                            execCommand: """
                              set +x
                              set -e
                              
                              # 불변 배포용 고유 빌드 태깅 변수 주입
                              TAG='${TAG}'
                              
                              cd ~/ees-app
                              
                              # 처음 배포 시 .env 파일 복사
                              if [ ! -f .env ]; then
                                cp .env.example .env
                                echo "⚠️ [WARNING] .env 파일이 생성되었습니다. 연결을 채워주십시오."
                              fi
                              
                              # [롤백 고도화] 이전 가동 중인 불변 이미지 버전을 .env에서 읽어와 BACKUP_TAG로 고정 기록
                              OLD_TAG=\$(grep -E "^TAG=" .env | cut -d'=' -f2 || echo "latest")
                              sed -i "s/^BACKUP_TAG=.*/BACKUP_TAG=\${OLD_TAG}/g" .env || echo "BACKUP_TAG=\${OLD_TAG}" >> .env
                              
                              # .env 파일에 새 배포 불변 태그 주입
                              sed -i "s/^TAG=.*/TAG=\${TAG}/g" .env || echo "TAG=\${TAG}" >> .env
                              
                              # 새 이미지 정밀 pull (원격 서버의 도커 데몬 자동 캐시 인증 가동)
                              docker compose -f docker-compose.prod.yml pull
                              
                              # 불변 이미지를 기반으로 무중단 배포 및 누적 고아 컨테이너 Prune 처리
                              docker compose -f docker-compose.prod.yml up -d --remove-orphans
                              
                              chmod +x ./deploy_verify.sh ./rollback.sh
                              
                              # [배포 안정성] 검증 시 젠킨스가 무한 루프에 빠지지 않도록 60초 타임아웃 및 꼬임 없는 이미지 기반 롤백 연동
                              timeout 60 ./deploy_verify.sh || (./rollback.sh && exit 1)
                            """
                          )
                        ]
                    )
                ])
            }
        }
    }

    post {
        success {
            echo '🚀 EES KT Cloud Ubuntu 서버 무결성 배포 및 최종 검증 성공!'
        }
        failure {
            echo '❌ 배포 실패! 이전 쌩쌩한 안전 버전으로 무결성 이미지 롤백 완료!'
        }
        always {
            // [정리 고도화] 로컬 캐시 이미지 정리 및 젠킨스 전용 Dangling 이미지 완전 소거
            sh "docker rmi ${REGISTRY_USER}/${IMAGE_NAME}:${TAG} || true"
            sh 'docker image prune -f || true'
            cleanWs()
        }
    }
}