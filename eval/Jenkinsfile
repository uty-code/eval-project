pipeline {
    agent any

    environment {
        REGISTRY_USER = 'siujeong'
        IMAGE_NAME = 'ees-eval-app'
        TAG = "${env.BUILD_NUMBER}"
        REGISTRY_CRED_ID = 'ees-registry-creds' 
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Build & Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: env.REGISTRY_CRED_ID, usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                    // 1. 도커 허브 로그인
                    sh "docker login -u ${REG_USER} -p ${REG_PASS}"
                    
                    // 2. 도커 빌드 및 레지스트리 푸시
                    dir('eval') {
                        sh """
                            docker build -t ${REGISTRY_USER}/${IMAGE_NAME}:${TAG} .
                            docker push ${REGISTRY_USER}/${IMAGE_NAME}:${TAG}
                            
                            docker tag ${REGISTRY_USER}/${IMAGE_NAME}:${TAG} ${REGISTRY_USER}/${IMAGE_NAME}:latest
                            docker push ${REGISTRY_USER}/${IMAGE_NAME}:latest
                        """
                    }
                }
            }
        }

        stage('Deploy via SSH to Ubuntu') {
            steps {
                withCredentials([usernamePassword(credentialsId: env.REGISTRY_CRED_ID, usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                    // Jenkins Credentials에 등록된 ees-ubuntu-server 접속 설정을 통해 배포 전송 및 명령 실행
                    // 쌍따옴표 내에서 $은 \$로 에스케이프 처리하여 쉘의 환경 변수가 원격 우분투로 정상 전달되도록 매핑합니다.
                    sshPublisher(publishers: [
                        sshPublisherDesc(configName: 'ees-ubuntu-server', 
                            transfers: [
                              sshTransfer(
                                sourceFiles: 'eval/docker-compose.prod.yml, eval/.env.example, eval/deploy_verify.sh, eval/rollback.sh',
                                removePrefix: 'eval',
                                remoteDirectory: 'ees-app',
                                execCommand: """
                                  cd ~/ees-app
                                  
                                  # 우분투 서버에서 도커 허브 로그인 수행 (Private 이미지 Pull 권한 획득)
                                  docker login -u \$REG_USER -p \$REG_PASS
                                  
                                  # 처음 배포 시 .env 파일이 없으면 템플릿 복사
                                  if [ ! -f .env ]; then
                                    cp .env.example .env
                                    echo "⚠️ [WARNING] .env 파일이 새로 생성되었습니다. 실제 DB 연결 설정을 채워주십시오."
                                  fi
                                  
                                  # 기존 실행 중인 컨테이너 백업 (이전 이미지 보존용)
                                  docker stop ees-app-backup || true
                                  docker rm ees-app-backup || true
                                  docker rename ees-eval-app ees-app-backup || true
                                  
                                  # 최신 도커 이미지 레지스트리(Docker Hub)로부터 초고속 다운로드
                                  docker compose -f docker-compose.prod.yml pull
                                  
                                  # 새 컨테이너 생성 및 기동
                                  docker compose -f docker-compose.prod.yml up -d --force-recreate
                                  
                                  # 스크립트 실행 권한 부여
                                  chmod +x ./deploy_verify.sh ./rollback.sh
                                  
                                  # 배포 헬스체크 검증 수행 및 실패 시 즉각 원클릭 자동 롤백 연동
                                  ./deploy_verify.sh || (./rollback.sh && exit 1)
                                """
                              )
                            ]
                        )
                    ])
                }
            }
        }
    }

    post {
        success {
            echo '🚀 KT Cloud Ubuntu 서버 배포 및 검증이 완료되었습니다!'
        }
        failure {
            echo '❌ 배포 실패! 안정적인 기존 버전으로 자동 롤백을 수행하였습니다.'
        }
        always {
            // 로컬에 생성된 이미지 삭제 (용량 확보)
            sh "docker rmi ${REGISTRY_USER}/${IMAGE_NAME}:${TAG} || true"
            cleanWs()
        }
    }
}