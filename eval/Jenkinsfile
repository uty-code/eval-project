pipeline {
    agent any

    environment {
        IMAGE_NAME = 'ees-eval-app'
        TAG = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Build') {
            steps {
                dir('eval') {
                    // 멀티 스테이지 Dockerfile을 통해 메이븐 빌드와 이미지 패키징을 동시 수행
                    sh """
                        docker build -t ${IMAGE_NAME}:${TAG} .
                        docker tag ${IMAGE_NAME}:${TAG} ${IMAGE_NAME}:latest
                    """
                }
            }
        }

        stage('Deploy via SSH to Ubuntu') {
            steps {
                // Jenkins Credentials에 등록된 ees-ubuntu-server 접속 설정을 통해 배포 전송 및 명령 실행
                sshPublisher(publishers: [
                    sshPublisherDesc(configName: 'ees-ubuntu-server', 
                        transfers: [
                          sshTransfer(
                            sourceFiles: 'eval/docker-compose.prod.yml, eval/.env.example, eval/deploy_verify.sh, eval/rollback.sh',
                            removePrefix: 'eval',
                            remoteDirectory: 'ees-app',
                            execCommand: '''
                              cd ~/ees-app
                              
                              # 처음 배포 시 .env 파일이 없으면 템플릿 복사
                              if [ ! -f .env ]; then
                                cp .env.example .env
                                echo "⚠️ [WARNING] .env 파일이 새로 생성되었습니다. 실제 DB 연결 설정을 채워주십시오."
                              fi
                              
                              # 기존 실행 중인 컨테이너 백업 (이전 이미지 보존용)
                              docker stop ees-app-backup || true
                              docker rm ees-app-backup || true
                              docker rename ees-eval-app ees-app-backup || true
                              
                              # 새 컨테이너 생성 및 기동
                              docker compose -f docker-compose.prod.yml up -d --force-recreate
                              
                              # 스크립트 실행 권한 부여
                              chmod +x ./deploy_verify.sh ./rollback.sh
                              
                              # 배포 헬스체크 검증 수행 및 실패 시 즉각 원클릭 자동 롤백 연동
                              ./deploy_verify.sh || (./rollback.sh && exit 1)
                            '''
                          )
                        ]
                    )
                ])
            }
        }
    }

    post {
        success {
            echo '🚀 KT Cloud Ubuntu 서버 배포 및 검증이 완료되었습니다!'
        }
        failure {
            echo '❌ 배포 실패! 안정적인 기존 버전으로 자동 롤백을 수행하였습니다.'
        }
        always {
            cleanWs()
        }
    }
}